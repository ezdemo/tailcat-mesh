server:
  url: https://mesh.example.com

device:
  # Optional; defaults to the local hostname.
  name: DESKTOP-ABC

tailcat:
  # Omit binary to use the per-user ~/.tailcat-mesh cache.
  version: 0.3.0
  autoDownload: true
  supportedVersion: 0.3.x
  serverKey: tailcat-mesh-server
  clientKey: tailcat-mesh-client
  fullAddress: true
  derpMapUrl: ""

agent:
  dataDir: ./data
  heartbeatSeconds: 15
  peerPingSeconds: 30

# M7 Virtual LAN is opt-in because it creates a system TUN and Mesh CIDR routes.
# The tun2socks argument list is intentionally explicit: different binaries
# expose different flags. Use ${tun} and ${proxy} placeholders as needed.
virtualLan:
  enabled: false
  interfaceName: TailcatMesh
  adapterGuid: 7d2a8db0-6f69-4d26-9d6e-9e0e4d2c6b71
  wintunDll: ~/.tailcat-mesh/virtual-lan/windows/wintun.dll
  tun2socksBinary: ~/.tailcat-mesh/virtual-lan/windows/tun2socks.exe
  tun2socksArguments:
    - --device
    - ${tun}
    - --proxy
    - ${proxy}
  commandTimeoutSeconds: 15
  startupTimeoutSeconds: 15

forward:
  defaultBindHost: 127.0.0.1

logging:
  level: INFO
